# Public application URL, used only by server-side callback and email-link generation.
APP_URL="http://localhost:3000"

# ==============================================================================
# SUPABASE MODERN API CONFIGURATION
# Supabase has migrated from legacy JWT API keys ('anon' / 'service_role') to:
#   1. Publishable Key: Safe for browser use with Row Level Security (RLS)
#   2. Secret Key: Privileged server-only access (never expose to client)
# ==============================================================================

# SUPABASE_URL: URL of your Supabase project (e.g. https://dktbguaggounkorfodcp.supabase.co)
# Supports both Next.js public prefix and Vite prefix
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_PUBLISHABLE_KEY: Modern client-safe publishable key starting with 'sb_publishable_'
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key_here"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key_here"

# LEGACY ANON KEY FALLBACK: Maintained for backward compatibility with existing projects
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-legacy-anon-key-here"
VITE_SUPABASE_ANON_KEY="your-legacy-anon-key-here"

# SUPABASE_SECRET_KEY: Server-side only key starting with 'sb_secret_'.
# WARNING: NEVER prefix with NEXT_PUBLIC_ or VITE_. Keep strictly in server environment.
SUPABASE_SECRET_KEY="sb_secret_your_secret_key_here"

# KYC identity encryption and identity-hash pepper. Generate distinct, high-entropy values,
# store them only in your deployment secret manager and never expose them to the browser.
KYC_PII_ENCRYPTION_KEY="replace-with-a-server-only-secret-at-least-32-characters"
KYC_PII_HASH_PEPPER="replace-with-a-different-server-only-secret-at-least-32-characters"

STAFF_INVITE_EMAIL_TOKEN="replace-with-a-server-only-secret-at-least-32-characters"

# Authentication can run with this false. Keep it false until repository/server workflows
# have been implemented and validated.
NEXT_PUBLIC_SUPABASE_RUNTIME_ENABLED="false"

# ===============================================================================
# SERVER-ONLY PAYMENT PROVIDERS
# Never prefix these variables with NEXT_PUBLIC_. Do not enter provider secrets in
# browser settings screens. The future server adapter selects Daraja, PayHero, or
# Finoq by capability and configured routing priority.
# ===============================================================================
PAYMENT_PROVIDER_ENCRYPTION_KEY="replace-with-a-server-only-32-byte-secret"

# Daraja
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_PASSKEY=""

# PayHero credentials belong in Supabase Edge Function secrets, not this file:
# supabase secrets set PAYHERO_BASIC_AUTH_TOKEN=... PAYHERO_CHANNEL_ID=... PAYHERO_CALLBACK_TOKEN=...

# Customer notification email credentials also belong in Supabase Edge Function secrets:
# supabase secrets set RESEND_API_KEY=... EMAIL_FROM='Your Brand <notices@your-verified-domain.com>'
# Optional automatic fallback: BREVO_API_KEY=... BREVO_SENDER_EMAIL=... BREVO_SENDER_NAME='Your Brand'

# Finoq
FINOQ_API_KEY=""

